# /workspace/web/api.env on the GPU box. Read by supervisord's programs: the tunnel, the API, the ingestion supervisor
# (and through it every ingestion child) and llama-server.
#
# The box holds no client data and no database password (docs/web_deploy.md, "Where data lives"): the databases are
# the VPS's, reached through the tunnel's end at 127.0.0.1:15432 with a password the gateway hands out at each start,
# and the VPS moves each ingestion's files in and out itself.

# --- the Hetzner VPS, which holds the data ---
VPS_HOST=
VPS_SSH_PORT=22
# Copy from /etc/onyx-web-gateway.env on the VPS
WEB_API_SECRET=

# --- the appliance (app/core/config.py) ---
ENV=production
ONYX_ROOT=/workspace/onyx_v3
# The VPS's Postgres, through the tunnel (box_tunnel.sh forwards this port)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
# The box's own role: it may log in only while the gateway has the box started
POSTGRES_USER=izvoria_box
# No POSTGRES_PASSWORD here, ever: every connection asks the gateway for the current one, through the tunnel
BOX_CREDENTIALS_URL=http://127.0.0.1:18000/internal/box/credentials
REMEMBER_LANGUAGE=false
APPLIANCE_LANGUAGE=en

# The file is sourced by bash: keep the JSON lists single-quoted.
# Hosted, multi-user serving. Each of these defaults to the single-user appliance; see CLAUDE.md and
# docs/web_deploy.md before changing one.
ENGINE_CONCURRENT_LIVE=true
LLM_BACKEND=llama_server
LLM_SERVER_URL=http://127.0.0.1:8081
LLM_SERVER_PARALLEL=6
LLM_SERVER_KV_TOKENS=196608
MODEL_KEEP_WARM=false
MODEL_PINNED_TYPES='["rag_embedding","rag_reranking"]'
MODEL_EXTERNAL_TYPES='["qa_generation","qa_reasoner","report_authoring","retrieval_scrubber"]'
# The scrubber is the resident 9B (judging several chunks at once in parallel slots), not a second model
RETRIEVAL_SCRUBBER_MODEL_PATH=models/Qwen3.5-9B-Q4_K_M.gguf
RETRIEVAL_SCRUBBER_CONCURRENCY=3
REPORT_MAX_CONCURRENT=2
# Answers before long prompts (patched llama-server, web_deploy/provision/llama_patches/0001): while anyone's answer
# is being written, a prompt with more than this many tokens left to read waits, so one long report section or
# conversation can't slow every chat to a crawl. Measured on the dev card: chats beside a 40K-token request 43 s ->
# 13 s; the long request 9% slower. 0 or unset: llama-server's own order.
ONYX_SHORT_PROMPT_TOKENS=16384
ONYX_LONG_PROMPT_TRICKLE=0

# --- storage: keep one compact file per recording (docs/web_deploy.md, "Storage") ---
# No per-chunk clips (a citation is cut from the recording when opened), no WAV once a recording is indexed, and
# the original swapped for a 720p H.264/AAC MP4 (audio: AAC m4a) once it is indexed
VIDEO_CLIPS_ENABLED=false
KEEP_EXTRACTED_AUDIO=false
COMPACT_MEDIA_ORIGINALS=true
# A report lives in its database row only: no Markdown copy on this box's disk (downloads render from the row)
REPORT_FILES_ENABLED=false

# --- the web API (web_deploy/api/config.py) ---
# Scratch, at the SAME absolute path as the VPS's tenants (the database stores absolute file paths). Holds one job's
# files while it ingests, wiped afterwards (web_deploy/ingest_worker/staging.py)
TENANTS_ROOT=/workspace/tenants
# Temporary files of the pipelines (audio cuts, page renders) stay beside the scratch, emptied at every start
TMPDIR=/workspace/tmp
WEB_LIVE_WORKERS=8
FIRM_DB_POOL_SIZE=3
FIRM_DB_POOL_OVERFLOW=3
# CONTROL_DATABASE_URL defaults to postgresql+psycopg2://$POSTGRES_USER@.../onyx_control (password from the gateway)

# --- the ingestion worker ---
# VRAM an ingestion load must leave free beside the live models (KV fill, activation spikes)
INGEST_VRAM_HEADROOM_MB=1500
# The VPS moves each job's files in and out itself (gateway/staging_server.py); the box only asks, through the tunnel
BOX_GATEWAY_URL=http://127.0.0.1:18000
STAGING_STATE_DIR=/workspace/staging-state
# The VPS's host key, pinned for the tunnel (written by provision.sh)
STAGING_KNOWN_HOSTS=/workspace/web/known_hosts
# The tunnel (box_tunnel.sh)
TUNNEL_SSH_KEY=/workspace/web/tunnel_ed25519
BOX_TUNNEL_PORT=18095
