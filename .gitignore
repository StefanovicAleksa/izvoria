# --- Python Core ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments ---
# Anchored to root (/) to avoid ignoring 'env' folders inside data if valid
/venv/
/env/
/.env
/.venv
/env.bak/
/venv.bak/
/deploy/.venv/

# --- Environment Variables & Secrets ---
.env
.env.local

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
# Ignore temp artifacts wherever they appear
**/temp_artifacts/
test_output.txt
test_outputs.txt

# --- Project Data & Artifacts ---
# Anchored to ensure we only target the root data folder
/data/artifacts/*
!/data/artifacts/.gitkeep

# The runtime vault and everything the appliance writes at run time: ingested client media under
# onyx_data/<YYYY>/<MM>/<DD>/, and generated research reports under onyx_data/<env>/reports/.
# This is customer data on a customer's machine -- it must never reach a repository.
/onyx_data/

# --- Machine Learning Models (Root Only) ---
# IMPORTANT: Leading slash prevents ignoring valid 'models.py' files in your app
/local_models/
/models/

# Large File Extensions (Weights & Binaries) - recursive
*.safetensors
*.bin
*.pth
*.pt
*.ckpt
*.h5
*.nemo

# --- Media Files (Ingest/Output) ---
*.mp3
*.mp4
*.wav
*.flac

# --- Logs ---
*.log
/logs/

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Scripts & Temp Files ---
*.sh
# Setup and deployment scripts the README tells people to run
!/setup_env.sh
!/models_download.sh
!/update_nvidia_driver.sh
!/deploy/**/*.sh

*.txt
!requirements.txt
!requirements-dev.txt
!requirements-nodeps.txt

*.db

!integration_tests/resources/
!integration_tests/resources/*

combine_files_git.sh

*jpg

.env.prod
.env.test

input_video