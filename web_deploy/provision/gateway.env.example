# /etc/onyx-web-gateway.env on the Hetzner VPS (install_gateway.sh creates it from this file, with fresh secrets).
# Read by the gateway and the backup service. The VPS holds every firm's data (docs/web_deploy.md, "Where data lives").

# The one address every firm signs in at (the owner too, as the firm "admin")
PUBLIC_URL=https://onyx.example.com
# Shared with the GPU box: copy it into its /workspace/web/api.env
WEB_API_SECRET=

# Vast.ai: an API key, and the id of the instance provision.sh ran on
VAST_API_KEY=
# One instance id, or several comma-separated, primary first (spares: docs/web_deploy.md "Spare boxes")
VAST_INSTANCE_ID=
# The box dials in over SSH and forwards its API here (box_tunnel.sh); it exposes no port of its own
BOX_LINK=tunnel
BOX_TUNNEL_PORT=18095

# Stop the GPU box after this many minutes with no user activity and nothing running or queued
IDLE_MINUTES=30

GATEWAY_DB=/var/lib/onyx-web/gateway.sqlite3

# --- the firms' data, here ---
# Postgres on loopback (the box reaches it through its tunnel). The password is shared with the box's api.env
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=onyx
POSTGRES_PASSWORD=
# Vaults and uploads, at the same absolute path the box uses for its scratch (the database stores absolute paths).
# Mount a Hetzner Volume at /workspace.
TENANTS_ROOT=/workspace/tenants
# Cuts of cited recordings and transcodes, made when a source is opened (capped at 5 GB)
SOURCE_CACHE_ROOT=/workspace/source-cache
# The largest file one upload may be
MAX_UPLOAD_BYTES=21474836480
# Make each uploaded video's 720p copy here before the GPU box sees it (docs/web_deploy.md, "Videos are prepared on
# the VPS"): only the copy travels to the box and is ingested. The vision model sees at most ~720p anyway; check
# once that small slide text survives the encode (lower PREPARE_VIDEO_CRF if it smears), then turn it on.
PREPARE_VIDEOS=false
PREPARE_VIDEO_MAX_HEIGHT=720
PREPARE_VIDEO_CRF=26
# x264 speed: the VPS's CPU is what a batch waits on (ultrafast … medium; slower = smaller files)
PREPARE_PRESET=faster
# The audio Whisper transcribes: kept above the vault's 96k
PREPARE_AUDIO_BITRATE=128k

# --- email for the "Request Izvoria" and "Help & support" pages ---
# Requests are always stored (the owner's console lists them); with SMTP_HOST empty they are not emailed.
# Hetzner Cloud blocks outbound ports 25 and 465 on new projects: use 587 with STARTTLS, or ask them to
# unblock. Any provider works (a transactional mail service, or the domain's own mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# SMTP_SSL=1 with SMTP_PORT=465 for implicit TLS instead of STARTTLS
MAIL_FROM=
# Where sign-up requests go, and help requests (SUPPORT_TO defaults to SIGNUP_TO)
SIGNUP_TO=
SUPPORT_TO=
# Leave unset in production; FAKE_BOX_HOST=127.0.0.1 and GATEWAY_HTTPS_ONLY=0 are for a local end-to-end run

# --- backups to a Hetzner Storage Box (docs/web_deploy.md, "Backups") ---
# Every firm database and vault (the onyx-web-backup service), and the gateway database (the daily timer), with
# restic, encrypted with RESTIC_PASSWORD. KEEP A COPY OF THAT PASSWORD OFF THIS MACHINE: without it the backups
# cannot be read. Both log in with /etc/onyx-web/backup_ed25519 on port 23.
BACKUP_ENABLED=true
# sftp:<user>@<user>.your-storagebox.de:onyx-backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
