# Settings for the web version on DEV HARDWARE (one 12 GB GPU, served on your local network).
# run_local.py copies this to web_deploy/local/local.env on its first run, with a fresh secret; edit that copy.
# Postgres and model paths come from the repo's .env as always (ENV=development, the db_dev container).

# --- shared by the gateway, the API and the ingestion worker ---
WEB_API_SECRET=

# --- where things live (relative paths are under the repo) ---
LOCAL_DATA_DIR=onyx_data/local-web

# --- the gateway: one LAN address over plain HTTP; sign in as the firm, then as yourself ---
LOCAL_PORT=8000
BOX_MODE=local
GATEWAY_HTTPS_ONLY=0

# --- YouTube links on the Ingest page (video only; the downloads use this machine's internet connection) ---
LINK_INGEST_ENABLED=true
LINK_MAX_VIDEOS=200
LINK_MAX_HEIGHT=720

# --- email for the "Request Onyx" and "Help & support" pages ---
# Requests are always stored (the owner's console lists them); with SMTP_HOST empty they are not emailed.
# Gmail: turn on 2-step verification, make an app password (myaccount.google.com/apppasswords) and use it here;
# MAIL_FROM must be the same Gmail address or Gmail rewrites it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# SMTP_SSL=1 with SMTP_PORT=465 for implicit TLS instead of STARTTLS
MAIL_FROM=
# Where sign-up requests go, and help requests (SUPPORT_TO defaults to SIGNUP_TO)
SIGNUP_TO=
SUPPORT_TO=

# --- the live models: Qwen3.5-9B in llama-server at the full 128K context, 3 parallel slots ---
# Measured 2026-10-04 on the RTX 3060: llama-server 8.1 GB, plus BGE-M3 and the reranker under load, left 0.7 GB free.
ENGINE_CONCURRENT_LIVE=true
LLM_BACKEND=llama_server
LLM_SERVER_URL=http://127.0.0.1:8081
LLM_SERVER_PARALLEL=3
LLM_SERVER_KV_TOKENS=131072
# Built by `run_local.py build-llama-server` (into LOCAL_DATA_DIR/llama.cpp) unless you point at your own build
LLAMA_SERVER_BIN=
MODEL_KEEP_WARM=false
MODEL_PINNED_TYPES='["rag_embedding","rag_reranking"]'
MODEL_EXTERNAL_TYPES='["qa_generation","qa_reasoner","report_authoring","retrieval_scrubber"]'
# The reranker is pinned against this bound plus a 500 MB margin, after llama-server and BGE-M3 have taken theirs.
# The default (1500) asks for 2.0 GB free; with the desktop session holding ~0.8 GB of the card, 1.95 GB is.
# Measured 2026-10-07: 1.6 GB in use under load.
RAG_RERANKER_VRAM_REQUIREMENT_MB=1400
RETRIEVAL_SCRUBBER_MODEL_PATH=models/Qwen3.5-9B-Q4_K_M.gguf
RETRIEVAL_SCRUBBER_CONCURRENCY=3
REPORT_MAX_CONCURRENT=2
REMEMBER_LANGUAGE=false
# Answers before long prompts (patched llama-server, web_deploy/provision/llama_patches/0001): while anyone's answer
# is being written, a prompt with more than this many tokens left to read waits, so one long report section or
# conversation can't slow every chat to a crawl. Measured on the dev card: chats beside a 40K-token request 43 s ->
# 13 s; the long request 9% slower. 0 or unset: llama-server's own order.
ONYX_SHORT_PROMPT_TOKENS=16384
ONYX_LONG_PROMPT_TRICKLE=0

# --- storage: keep one compact file per recording (docs/web_deploy.md, "Storage") ---
# No per-chunk clips (a citation is cut from the recording when opened), no WAV once a recording is indexed, and
# the original swapped for a 720p H.264/AAC MP4 (audio: AAC m4a) once it is indexed
VIDEO_CLIPS_ENABLED=false
KEEP_EXTRACTED_AUDIO=false
COMPACT_MEDIA_ORIGINALS=true

# --- ingestion takes the whole card: the live models step aside while the queue has work ---
GPU_SHARING=exclusive
INGEST_VRAM_HEADROOM_MB=0
WEB_LIVE_WORKERS=6
