# /etc/onyx-web-gateway.env on the Hetzner VPS (install_gateway.sh creates it from this file).

# The one address every firm signs in at (the owner too, as the firm "admin")
PUBLIC_URL=https://onyx.example.com
# The same value as on the GPU box (/workspace/web/api.env, printed by provision.sh)
WEB_API_SECRET=
# The GPU box API's self-signed certificate (/workspace/web/tls/cert.pem on the box), pinned
BOX_CERT_FILE=/etc/onyx-web/box-cert.pem

# Vast.ai: an API key, and the id of the instance provision.sh ran on
VAST_API_KEY=
VAST_INSTANCE_ID=

# Stop the GPU box after this many minutes with no user activity and nothing running or queued
IDLE_MINUTES=30

GATEWAY_DB=/var/lib/onyx-web/gateway.sqlite3

# --- email for the "Request Izvoria" and "Help & support" pages ---
# Requests are always stored (the owner's console lists them); with SMTP_HOST empty they are not emailed.
# Hetzner Cloud blocks outbound ports 25 and 465 on new projects: use 587 with STARTTLS, or ask them to
# unblock. Any provider works (a transactional mail service, or the domain's own mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# SMTP_SSL=1 with SMTP_PORT=465 for implicit TLS instead of STARTTLS
MAIL_FROM=
# Where sign-up requests go, and help requests (SUPPORT_TO defaults to SIGNUP_TO)
SIGNUP_TO=
SUPPORT_TO=
# Leave unset in production; FAKE_BOX_HOST=127.0.0.1 and GATEWAY_HTTPS_ONLY=0 are for a local end-to-end run

# --- backups of this gateway's database (firms, accounts): the same repository and password as the GPU box ---
# Daily, by the onyx-web-gateway-backup timer; logs in with /etc/onyx-web/backup_ed25519 on port 23
BACKUP_ENABLED=true
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
