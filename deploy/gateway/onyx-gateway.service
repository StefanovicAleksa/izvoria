[Unit]
Description=Izvoria demo gateway
After=network-online.target
Wants=network-online.target

[Service]
User=onyx
WorkingDirectory=/opt/onyx_v3
EnvironmentFile=/etc/onyx-gateway.env
ExecStart=/opt/onyx-gateway/bin/uvicorn deploy.gateway.app:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
