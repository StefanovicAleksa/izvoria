# ==========================================
# DATABASE CONFIGURATION (Postgres)
# ==========================================
# Used by both Docker (to create DB) and Python (to connect)
POSTGRES_SERVER=your_postgres_server
POSTGRES_PORT=your_postgres_port
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# ==========================================
# APP SETTINGS
# ==========================================
APP_NAME=your_app_name
ENV=your_environment

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# Pool Size: How many connections to keep open constantly.
DB_POOL_SIZE=your_db_pool_size
# Max Overflow: How many extra connections to allow during traffic spikes.
DB_MAX_OVERFLOW=your_db_max_overflow

# ==========================================
# APPLIANCE DOMAIN ADAPTATION
# ==========================================
# Defines the overarching industry and language for the local knowledge base
APPLIANCE_INDUSTRY=your_appliance_industry
APPLIANCE_LANGUAGE=your_appliance_language

# ==========================================
# CPU MODELS (Discovery Phase / Domain Adaptation)
# ==========================================
# These models run strictly on system RAM to preserve the 12GB GPU budget
DISCOVERY_SCOUT_MODEL_PATH=your_discovery_scout_model_path
DISCOVERY_CLASSIFIER_MODEL_PATH=your_discovery_classifier_model_path

# ==========================================
# GPU MODELS (Pipeline Phases)
# ==========================================
VAD_MODEL_PATH=your_vad_model_path
WHISPER_MODEL_PATH=your_whisper_model_path
DIARIZATION_MODEL_PATH=your_diarization_model_path
NLP_MODEL_PATH=your_nlp_model_path
SAT_MODEL_NAME=your_sat_model_name
ASR_PHASE_1_MODEL_PATH=your_asr_phase_1_model_path
ASR_PHASE_2_MODEL_PATH=your_asr_phase_2_model_path
ASR_PHASE_3_MODEL_PATH=your_asr_phase_3_model_path