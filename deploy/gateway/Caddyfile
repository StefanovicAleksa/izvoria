# /etc/caddy/Caddyfile on the gateway VPS. Replace demo.example.com with your domain (an A record pointing at the
# VPS must exist first); Caddy fetches and renews the Let's Encrypt certificate itself.
demo.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		# Uploads are multi-gigabyte videos: stream them through instead of buffering on this small VPS.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	request_body {
		max_size 20GB
	}
}
