# Copy to /etc/onyx-gateway.env (chmod 600, owned by root). Every value here is a secret.

# What the tester types on the landing page. At least 12 characters.
GATEWAY_PASSWORD=

# Signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Printed by deploy/instance/provision.sh on the GPU box (also in /workspace/secrets.env there).
AGENT_SECRET=
WEBSOCKIFY_TOKEN=

# Vast console -> Account -> API keys. The key never leaves this VPS.
VAST_API_KEY=
# The instance's ID, shown on its card in the Vast console.
VAST_INSTANCE_ID=

# Stop the GPU box after this many minutes with nobody connected and nothing running.
IDLE_MINUTES=30
